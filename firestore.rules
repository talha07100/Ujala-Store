rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function isOwner(){return request.auth != null && request.auth.token.email == "talhakhan14746@gmail.com";}
  match /products/{id}{allow read: if true; allow create,update,delete: if isOwner(); match /reviews/{rid}{allow read: if true; allow create,update,delete: if isOwner();}}
  match /productPhotos/{id}{allow read: if true; allow create,update,delete: if isOwner();}
  match /orders/{id}{allow create: if true; allow read,update,delete: if isOwner();}
 }
}